{
  "name": "dev-tools",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.14.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "licenses": "npx license-checker-rseidelsohn --markdown --direct > LICENSES.md",
    "update": "npx -p npm-check-updates  -c 'ncu'",
    "upgrade": "npx -p npm-check-updates  -c 'ncu -u'"
  },
  "dependencies": {
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@mui/icons-material": "^6.1.9",
    "@mui/material": "^6.1.9",
    "@types/intl": "^1.2.2",
    "bignumber.js": "^9.1.2",
    "eslint-plugin-neverthrow": "^1.1.4",
    "luxon": "^3.5.0",
    "neverthrow": "^8.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.0.1",
    "ulidx": "^2.4.1",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "license-checker-rseidelsohn": "^4.4.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.1"
  }
}
